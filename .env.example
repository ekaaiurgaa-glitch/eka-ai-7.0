# EKA-AI Platform Environment Configuration

# Database
DATABASE_URL=sqlite:///./eka_ai.db

# Gemini API Key — Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
PROJECT_NAME=EKA-AI Platform
API_V1_STR=/api/v1

# JWT Authentication
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: For PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost/eka_ai

# Optional: Monitoring
# SENTRY_DSN=https://...
# LOG_LEVEL=INFO
# JSON_LOGS=true
